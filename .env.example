# 联调用的本地数据：复制成 .env 后填上**你自己有权限**的内容。
#
#   cp .env.example .env
#   node --env-file=.env test/live.mjs
#
# .env 已被 .gitignore 挡住，不会进仓库；没填的项会跳过，不算失败。
# 这里不要写任何令牌：凭据由 lark-cli 自己保管，插件和测试都只认链接。

# 可选：用独立的 lark-cli profile 跑联调，避免刷新到日常凭据
#   lark-cli auth login --profile larktest
LARK_TEST_PROFILE=

# 可选：把 lark-cli 的状态目录重定向到别的 HOME（排障用，正常留空）
LARK_TEST_HOME=

# 云文档搜索关键词
LARK_TEST_SEARCH_QUERY=

# 一篇你有权限的新版文档（/docx/ 链接）
LARK_TEST_DOCX_URL=

# 一个知识库节点（/wiki/ 链接），用来验证 wiki→文档的解析
LARK_TEST_WIKI_URL=

# 一个电子表格（/sheets/ 链接）与其中一张工作表的名字
LARK_TEST_SHEET_URL=
LARK_TEST_SHEET_NAME=

# 一个多维表格（/base/ 链接）与其中一张数据表的名字
LARK_TEST_BASE_URL=
LARK_TEST_BASE_TABLE=

# 一个你所在的群（群名或 oc_ 开头的 chat_id）
LARK_TEST_CHAT=

# 跨群搜消息的关键词
LARK_TEST_MESSAGE_QUERY=

# 一篇带画板/评论的文档或 wiki 节点
LARK_TEST_BOARD_URL=

# 一条妙记（/minutes/ 链接）
LARK_TEST_MINUTES_URL=
